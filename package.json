{
  "name": "flow-war",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "bench:traffic": "tsx scripts/traffic-benchmark.ts && tsx scripts/market-benchmark.ts",
    "bench:actions": "tsx scripts/actions-benchmark.ts && tsx scripts/verify-actions-benchmark.ts",
    "bench:connections": "tsx scripts/connection-benchmark.ts",
    "bench:entrega5": "tsx scripts/entrega5-benchmark.ts",
    "bench:chat": "tsx scripts/chat-benchmark.ts",
    "history:admin": "tsx scripts/history-admin.ts",
    "bench:audit": "tsx scripts/audit-load.ts",
    "bench:classroom": "tsx scripts/audit-classroom-load.ts"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.2.5",
    "@fontsource/space-mono": "^5.2.9",
    "@xyflow/react": "^12.9.3",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
