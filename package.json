{
  "name": "flow-war",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "bench:traffic": "export FLOW_CALM_START=${FLOW_CALM_START:-0} && tsx scripts/traffic-benchmark.ts && tsx scripts/market-benchmark.ts",
    "bench:actions": "export FLOW_CALM_START=${FLOW_CALM_START:-0} && tsx scripts/actions-benchmark.ts && tsx scripts/verify-actions-benchmark.ts",
    "bench:connections": "export FLOW_CALM_START=${FLOW_CALM_START:-0} && tsx scripts/connection-benchmark.ts",
    "bench:entrega5": "export FLOW_CALM_START=${FLOW_CALM_START:-0} && tsx scripts/entrega5-benchmark.ts",
    "bench:chat": "export FLOW_CALM_START=${FLOW_CALM_START:-0} && tsx scripts/chat-benchmark.ts",
    "history:admin": "tsx scripts/history-admin.ts",
    "bench:audit": "export FLOW_CALM_START=${FLOW_CALM_START:-0} && node --import tsx scripts/audit-calibration.ts",
    "bench:classroom": "export FLOW_CALM_START=${FLOW_CALM_START:-0} && tsx scripts/audit-classroom-load.ts",
    "bench:snapshots": "export FLOW_CALM_START=${FLOW_CALM_START:-0} && tsx scripts/performance-classroom.ts",
    "bench:dvr-modes": "export FLOW_CALM_START=${FLOW_CALM_START:-0} && tsx scripts/performance-modes.ts",
    "bench:performance-matrix": "export FLOW_CALM_START=${FLOW_CALM_START:-0} && node scripts/performance-matrix.mjs",
    "bench:collaboration": "export FLOW_CALM_START=${FLOW_CALM_START:-0} && tsx scripts/collaboration-classroom.ts",
    "bench:ai": "export FLOW_CALM_START=${FLOW_CALM_START:-0} && node --import tsx scripts/ai-concurrency-benchmark.ts",
    "bench:executor": "export FLOW_CALM_START=${FLOW_CALM_START:-0} && node --import tsx scripts/executor-classroom.ts",
    "verify:anthropic": "node --env-file-if-exists=.env --import tsx scripts/anthropic-smoke.ts",
    "setup:anthropic": "tsx scripts/set-anthropic-key.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.0",
    "@fontsource/press-start-2p": "^5.2.5",
    "@fontsource/space-mono": "^5.2.9",
    "@xyflow/react": "^12.9.3",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
