# Copiar a .env local (ignorado por Git). Nunca usar VITE_ para secretos.
ANTHROPIC_API_KEY=
# Modelo de Claude. Sin valor se usa claude-haiku-5-5 (el más rápido y barato).
ANTHROPIC_MODEL=claude-haiku-5-5
# Para credenciales multi-workspace. Omitir para claves vinculadas a un workspace.
ANTHROPIC_WORKSPACE_ID=
# Esfuerzo del intérprete (low|medium|high|xhigh|max). Bajo por latencia; las órdenes son cortas.
FLOW_AI_EFFORT=low
# Máximo de tokens por respuesta (incluye el razonamiento interno del modelo).
FLOW_AI_MAX_TOKENS=4096
# Capacidad local, subordinada a la cuota real del proveedor.
FLOW_AI_CONCURRENCY=5
FLOW_AI_COMPANY_CONCURRENCY=2
FLOW_AI_QUEUE_LIMIT=30
# Espera total en cola y ejecución; el proveedor tiene además un plazo propio de 20 s.
FLOW_AI_TIMEOUT_MS=30000
FLOW_AI_PROVIDER_TIMEOUT_MS=20000
# Techo de consumo por partida (tokens de entrada + salida) y por empresa.
FLOW_AI_TOKEN_BUDGET=3000000
FLOW_AI_COMPANY_TOKEN_BUDGET=600000
# 0 desactiva el reintento automático en otro modelo cuando Claude rechaza por clasificadores de seguridad.
FLOW_AI_FALLBACKS=1
