# Copiar a .env local (ignorado por Git). Nunca usar VITE_ para secretos.
ANTHROPIC_API_KEY=
# Modelo con structured outputs disponible en tu cuenta; no se elige uno implícitamente.
ANTHROPIC_MODEL=
# Para credenciales multi-workspace. Omitir para claves vinculadas a un workspace.
ANTHROPIC_WORKSPACE_ID=
# Capacidad máxima local, subordinada a la cuota real del proveedor.
FLOW_AI_CONCURRENCY=5
FLOW_AI_QUEUE_LIMIT=30
FLOW_AI_TIMEOUT_MS=30000
# Variación pedagógica preexistente de propuestas Backend (0..100).
FLOW_AI_VARIATION_PERCENT=35
